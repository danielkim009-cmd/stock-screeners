<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockscreener.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/tastymaster/cline/stock-screeners/backend/.venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/tastymaster/cline/stock-screeners/backend</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Don't respawn faster than every 15s if the server crash-loops
         (e.g. port taken by a manually started dev server) -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/tmp/com.stockscreener.backend.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.stockscreener.backend.err.log</string>
</dict>
</plist>
